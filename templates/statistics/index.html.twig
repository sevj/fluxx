{% extends '@Fluxx/base.html.twig' %}
{% trans_default_domain 'fluxx' %}

{% block title %}{{ 'statistics_index.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-stack">
        <header class="header">
            <div>
                <h1 class="title">{{ 'statistics_index.heading'|trans }}</h1>
            </div>
        </header>

        <section class="section-card">
            <div class="section-heading">
                <div>
                    <h2 class="section-title">{{ 'statistics_index.overview_title'|trans }}</h2>
                    <p class="subtitle section-subtitle">{{ 'statistics_index.overview_subtitle'|trans }}</p>
                </div>
            </div>

            {% include '@Fluxx/_statistics_chart.html.twig' with {
                statistics: globalStatistics,
                range_route: 'fluxx_statistics_index',
                range_params: {}
            } %}
        </section>
    </div>
{% endblock %}
