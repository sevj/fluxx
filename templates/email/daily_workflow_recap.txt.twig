{% trans_default_domain 'fluxx' %}
{{ 'email_recap.title'|trans }}
{{ 'email_recap.period'|trans }}: {{ recap.from|date('Y-m-d H:i') }} -> {{ recap.to|date('Y-m-d H:i') }}

{{ 'email_recap.summary'|trans }}
- {{ 'email_recap.total_runs'|trans }}: {{ recap.totalRuns }}
- {{ 'email_recap.processed_records'|trans }}: {{ recap.processedCount }}
- {{ 'email_recap.successful_records'|trans }}: {{ recap.successCount }}
- {{ 'email_recap.errored_records'|trans }}: {{ recap.errorCount }}
- {{ 'email_recap.avg_step_duration'|trans }}: {{ recap.averageDurationMs is null ? '-' : recap.averageDurationMs ~ ' ms' }}
- {{ 'email_recap.max_step_duration'|trans }}: {{ recap.maxDurationMs is null ? '-' : recap.maxDurationMs ~ ' ms' }}

{{ 'email_recap.status_counts'|trans }}
{% for status, count in recap.statusCounts %}
- {{ ('workflow_status.' ~ status)|trans }}: {{ count }}
{% else %}
- {{ 'email_recap.no_workflow_run'|trans }}
{% endfor %}

{{ 'email_recap.workflows'|trans }}
{% for workflow, stats in recap.workflowCounts %}
- {{ workflow }}: {{ stats.total }} {{ 'email_recap.total'|trans|lower }}, {{ stats.errors }} {{ 'email_recap.errors'|trans|lower }}
{% else %}
- {{ 'email_recap.no_workflow_run'|trans }}
{% endfor %}

{{ 'email_recap.errored_section'|trans }}
{% for run in recap.erroredRuns %}
- {{ run.createdAt|date('Y-m-d H:i') }} | {{ run.workflow }} | {{ ('workflow_status.' ~ run.status)|trans }} | {{ run.runId }} | {{ run.error ?: '-' }}
{% for step in run.steps %}
  - {{ 'email_recap.step'|trans }} {{ step.code }} ({{ step.type }}) | {{ step.status }} | {{ 'email_recap.processed_label'|trans }}={{ step.processed }} {{ 'email_recap.success_label'|trans }}={{ step.success }} {{ 'email_recap.errors_label'|trans }}={{ step.errors }} {{ 'email_recap.retries_label'|trans }}={{ step.retries }} {{ 'email_recap.duration_label'|trans }}={{ step.durationMs is null ? '-' : step.durationMs ~ ' ms' }} {{ 'email_recap.memory_label'|trans }}={{ step.memoryPeakBytes is null ? '-' : (step.memoryPeakBytes / 1024 / 1024)|round(2) ~ ' MB' }}
    {{ 'email_recap.time'|trans }}: {{ step.startedAt ? step.startedAt|date('Y-m-d H:i:s') : '-' }} -> {{ step.finishedAt ? step.finishedAt|date('Y-m-d H:i:s') : '-' }}
    {{ 'email_recap.error'|trans }}: {{ step.error ?: '-' }}
{% for detail in step.errorDetails %}
    {{ detail }}
{% endfor %}
{% else %}
  - {{ 'email_recap.no_failed_step'|trans }}
{% endfor %}
{% else %}
- {{ 'email_recap.no_failed_run'|trans }}
{% endfor %}
