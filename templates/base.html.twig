{% trans_default_domain 'fluxx' %}
{% set fluxx_asset_version = 'design-v2-6' %}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Fluxx{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ path('fluxx_favicon_asset', {v: '20260616-favicon'}) }}">
    <script src="{{ path('fluxx_script_asset', {'script': 'theme', v: fluxx_asset_version}) }}"></script>
    <link rel="stylesheet" href="{{ path('fluxx_workflow_stylesheet', {v: fluxx_asset_version}) }}">
    {% block scripts %}{% endblock %}
</head>
<body>
    <main class="page{% block page_class %}{% endblock %}"{% block main_attributes %}{% endblock %}>
        {% block navigation %}
            {% include '@Fluxx/_navigation.html.twig' %}
        {% endblock %}

        {% block flashes %}
            {% set flash_groups = app.flashes %}
            {% if flash_groups is not empty %}
                <div class="flash-list">
                    {% for type, messages in flash_groups %}
                        {% for message in messages %}
                            <div class="flash flash-{{ type }}">{{ message|trans }}</div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endblock %}

        {% block body %}{% endblock %}
    </main>
</body>
</html>
