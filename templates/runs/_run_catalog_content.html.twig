{% trans_default_domain 'fluxx' %}
{% import '@Fluxx/_icons.html.twig' as icons %}
{% set filter_query = {
    'q': executionFilters.searchQuery,
    'workflow': executionFilters.workflowCode,
    'status': executionFilters.status,
    'errors': executionFilters.errorPresence,
    'from': executionFilters.dateFrom ? executionFilters.dateFrom|date('Y-m-d') : null,
    'to': executionFilters.dateTo ? executionFilters.dateTo|date('Y-m-d') : null
} %}
{% if runPage.items is empty %}
    <section class="empty">
        {{ executionFilters.hasActiveFilters ? 'run_index.empty_search'|trans : 'run_index.empty'|trans }}
    </section>
{% else %}
    <section class="workflow-list">
        <table class="workflow-table-compact">
            <colgroup>
                <col style="width: 9%">
                <col style="width: 13%">
                <col style="width: 6%">
                <col style="width: 7%">
                <col style="width: 7%">
                <col style="width: 7%">
                <col style="width: 7%">
                <col style="width: 14%">
                <col style="width: 13%">
                <col style="width: 17%">
            </colgroup>
            <thead>
                <tr>
                    <th>{{ 'run_index.run'|trans }}</th>
                    <th>{{ 'run_index.workflow'|trans }}</th>
                    <th>{{ 'run_index.category'|trans }}</th>
                    <th>{{ 'run_index.trigger'|trans }}</th>
                    <th>{{ 'run_index.source_system'|trans }}</th>
                    <th>{{ 'run_index.target_system'|trans }}</th>
                    <th>{{ 'run_index.status'|trans }}</th>
                    <th>{{ 'run_index.dates'|trans }}</th>
                    <th>{{ 'run_index.error'|trans }}</th>
                    <th>{{ 'run_index.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for run in runPage.items %}
                    <tr class="clickable-row" data-row-href="{{ path('fluxx_workflow_run_show', {'workflowCode': run.workflowCode, 'runId': run.runId}) }}" tabindex="0" role="link">
                        <td data-label="{{ 'run_index.run'|trans }}" class="execution-cell-run">
                            <a href="{{ path('fluxx_workflow_run_show', {'workflowCode': run.workflowCode, 'runId': run.runId}) }}" class="run-id">{{ run.runId }}</a>
                        </td>
                        <td data-label="{{ 'run_index.workflow'|trans }}">
                            <a href="{{ path('fluxx_workflow_show', {'code': run.workflowCode}) }}" class="workflow-link">
                                <div class="workflow-name">{{ run.workflowName ?: run.workflowCode }}</div>
                                <div class="item-code">{{ run.workflowCode }}</div>
                            </a>
                        </td>
                        <td data-label="{{ 'run_index.category'|trans }}">
                            {% if run.workflowCategory %}
                                <span class="system-chip">{{ run.workflowCategory }}</span>
                            {% endif %}
                        </td>
                        <td data-label="{{ 'run_index.trigger'|trans }}" class="execution-cell-trigger">
                            <span class="system-chip">{{ run.trigger }}</span>
                        </td>
                        <td data-label="{{ 'run_index.source_system'|trans }}">
                            <span class="system-chip system-chip-source">{{ run.sourceSystem }}</span>
                        </td>
                        <td data-label="{{ 'run_index.target_system'|trans }}">
                            <span class="system-chip system-chip-target">{{ run.targetSystem }}</span>
                        </td>
                        <td data-label="{{ 'run_index.status'|trans }}" class="execution-cell-status">
                            <span class="status-badge status-badge-{{ run.status|replace({'_': '-'}) }}">
                                {{ ('workflow_status.' ~ run.status)|trans }}
                            </span>
                            {% if run.lockKey and run.status in ['pending', 'relaunched', 'retrying', 'running'] %}
                                <span class="lock-badge" title="{{ 'run_index.locked'|trans({'%key%': run.lockKey}) }}" aria-label="{{ 'run_index.locked'|trans({'%key%': run.lockKey}) }}">{{ icons.icon('lock') }}</span>
                            {% endif %}
                        </td>
                        <td data-label="{{ 'run_index.dates'|trans }}" class="execution-cell-dates">
                            <div class="execution-dates">
                                <div class="execution-dates-item">
                                    <span class="execution-dates-label">{{ 'run_index.created_at'|trans }}</span>
                                    <span class="metric-value">{{ run.createdAt|date('d/m H:i') }}</span>
                                </div>
                                <div class="execution-dates-item">
                                    <span class="execution-dates-label">{{ 'run_index.started_at'|trans }}</span>
                                    {% if run.startedAt %}
                                        <span class="metric-value">{{ run.startedAt|date('d/m H:i') }}</span>
                                    {% else %}
                                        <span class="metric-empty">{{ 'run_index.not_started'|trans }}</span>
                                    {% endif %}
                                </div>
                                <div class="execution-dates-item">
                                    <span class="execution-dates-label">{{ 'run_index.finished_at'|trans }}</span>
                                    {% if run.finishedAt %}
                                        <span class="metric-value">{{ run.finishedAt|date('d/m H:i') }}</span>
                                    {% else %}
                                        <span class="metric-empty">{{ 'run_index.not_finished'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td data-label="{{ 'run_index.error'|trans }}" class="execution-cell-error">
                            {% if run.errorMessage %}
                                <div class="execution-error-preview" title="{{ run.errorMessage|e('html_attr') }}">{{ run.errorMessage|slice(0, 80) }}{% if run.errorMessage|length > 80 %}…{% endif %}</div>
                            {% else %}
                                <span class="metric-empty">-</span>
                            {% endif %}
                        </td>
                        <td data-label="{{ 'run_index.actions'|trans }}" class="execution-cell-actions">
                            <div class="execution-actions">
                                {% if run.status in ['failed', 'partially_failed', 'cancelled'] %}
                                    <form method="post" action="{{ path('fluxx_workflow_run_relaunch', {'workflowCode': run.workflowCode, 'runId': run.runId}) }}" class="execution-action-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('fluxx.relaunch.run.' ~ run.runId) }}">
                                        <input type="hidden" name="_redirect" value="{{ path('fluxx_run_index') }}">
                                        <button type="submit" class="secondary-button" data-run-catalog-action>
                                            <span class="button-icon" aria-hidden="true">{{ icons.icon('rotate-ccw') }}</span>
                                            <span class="button-label">{{ 'run_index.retry_run'|trans }}</span>
                                        </button>
                                    </form>
                                {% endif %}

                                {% if run.status in ['pending', 'relaunched', 'retrying', 'running'] %}
                                    <form method="post" action="{{ path('fluxx_workflow_run_cancel', {'workflowCode': run.workflowCode, 'runId': run.runId}) }}" class="execution-action-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('fluxx.cancel.run.' ~ run.runId) }}">
                                        <input type="hidden" name="_redirect" value="{{ path('fluxx_run_index') }}">
                                        <button type="submit" class="danger-button" data-run-catalog-action onclick="return confirm('{{ 'run_index.cancel_confirm'|trans|e('js') }}');">
                                            <span class="button-icon" aria-hidden="true">{{ icons.icon('x') }}</span>
                                            <span class="button-label">{{ 'run_index.cancel_run'|trans }}</span>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    {% if runPage.totalPages > 1 %}
        <nav class="pagination" aria-label="{{ 'pagination.label'|trans }}">
            <a href="{{ path('fluxx_run_index', filter_query|merge({'page': runPage.previousPage})) }}" class="pagination-link{{ not runPage.hasPreviousPage ? ' is-disabled' : '' }}" {{ not runPage.hasPreviousPage ? 'aria-disabled="true"' : '' }}>
                <span class="button-icon" aria-hidden="true">{{ icons.icon('arrow-left') }}</span>
                <span class="button-label">{{ 'pagination.previous'|trans }}</span>
            </a>

            <div class="pagination-pages">
                {% for pageNumber in runPage.pages %}
                    <a href="{{ path('fluxx_run_index', filter_query|merge({'page': pageNumber})) }}" class="pagination-link{{ pageNumber == runPage.currentPage ? ' is-active' : '' }}">
                        {{ pageNumber }}
                    </a>
                {% endfor %}
            </div>

            <a href="{{ path('fluxx_run_index', filter_query|merge({'page': runPage.nextPage})) }}" class="pagination-link{{ not runPage.hasNextPage ? ' is-disabled' : '' }}" {{ not runPage.hasNextPage ? 'aria-disabled="true"' : '' }}>
                <span class="button-label">{{ 'pagination.next'|trans }}</span>
                <span class="button-icon" aria-hidden="true">{{ icons.icon('arrow-right') }}</span>
            </a>
        </nav>
    {% endif %}
{% endif %}
