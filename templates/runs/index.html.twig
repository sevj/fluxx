{% trans_default_domain 'fluxx' %}
{% import '@Fluxx/_icons.html.twig' as icons %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'run_index.title'|trans }}</title>
    <link rel="icon" type="image/png" href="{{ path('fluxx_favicon_asset', {v: '20260616-favicon'}) }}">
    <script src="{{ path('fluxx_script_asset', {'script': 'theme', v: '20260616-js-split'}) }}"></script>
    <script defer src="{{ path('fluxx_script_asset', {'script': 'clickable-rows', v: '20260616-js-split'}) }}"></script>
    <script defer src="{{ path('fluxx_script_asset', {'script': 'run-catalog', v: '20260616-run-poll'}) }}"></script>
    <link rel="stylesheet" href="{{ path('fluxx_workflow_stylesheet', {v: '20260914-runs'}) }}">
</head>
<body>
    <main class="page">
        {% include '@Fluxx/_navigation.html.twig' %}

        <div class="page-stack">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <section class="section-card">
                        <div class="status-badge status-badge-{{ type == 'error' ? 'failed' : 'completed' }}">{{ message }}</div>
                    </section>
                {% endfor %}
            {% endfor %}

            <header class="header">
                <div>
                    <h1 class="title"><span class="title-icon" aria-hidden="true">{{ icons.icon('zap') }}</span>{{ 'run_index.heading'|trans }}</h1>
                </div>
                <div class="header-tools">
                    <form method="get" class="search-form">
                        <label class="search-label" for="run-search">{{ 'run_index.search_label'|trans }}</label>
                        <input
                            id="run-search"
                            type="search"
                            name="q"
                            value="{{ executionFilters.searchQuery }}"
                            class="search-input"
                            placeholder="{{ 'run_index.search_placeholder'|trans }}"
                        >
                        <button type="submit" class="secondary-button">
                            <span class="button-icon" aria-hidden="true">{{ icons.icon('search') }}</span>
                            <span class="button-label">{{ 'run_index.search_submit'|trans }}</span>
                        </button>
                        {% if executionFilters.hasActiveFilters %}
                            <a href="{{ path('fluxx_run_index') }}" class="secondary-button">
                                <span class="button-icon" aria-hidden="true">{{ icons.icon('rotate-ccw') }}</span>
                                <span class="button-label">{{ 'run_index.search_reset'|trans }}</span>
                            </a>
                        {% endif %}
                    </form>
                    <div class="count">
                        {{ 'run_index.count'|trans({
                            '%from%': runPage.firstItemNumber,
                            '%to%': runPage.lastItemNumber,
                            '%total%': runPage.totalItems
                        }) }}
                    </div>
                </div>
            </header>

            <section class="section-card">
                <form method="get" action="{{ path('fluxx_run_index') }}" class="run-filter-form">
                    <div class="run-filter-grid run-filter-grid-executions">
                        <label class="run-filter-field">
                            <span class="run-filter-label">{{ 'run_index.filter_workflow_label'|trans }}</span>
                            <select name="workflow" class="search-input">
                                <option value="">{{ 'run_index.filter_workflow_all'|trans }}</option>
                                {% for choice in workflowChoices %}
                                    <option value="{{ choice.code }}"{{ executionFilters.workflowCode == choice.code ? ' selected' : '' }}>
                                        {{ choice.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="run-filter-field">
                            <span class="run-filter-label">{{ 'run_index.filter_status_label'|trans }}</span>
                            <select name="status" class="search-input">
                                <option value="">{{ 'run_index.filter_status_all'|trans }}</option>
                                {% for status in ['pending', 'relaunched', 'retrying', 'running', 'cancelled', 'completed', 'failed', 'partially_failed'] %}
                                    <option value="{{ status }}"{{ executionFilters.status == status ? ' selected' : '' }}>
                                        {{ ('workflow_status.' ~ status)|trans }}
                                    </option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="run-filter-field">
                            <span class="run-filter-label">{{ 'run_index.filter_errors_label'|trans }}</span>
                            <select name="errors" class="search-input">
                                <option value="all"{{ executionFilters.errorPresence == 'all' ? ' selected' : '' }}>{{ 'run_index.filter_errors_all'|trans }}</option>
                                <option value="with"{{ executionFilters.errorPresence == 'with' ? ' selected' : '' }}>{{ 'run_index.filter_errors_with'|trans }}</option>
                                <option value="without"{{ executionFilters.errorPresence == 'without' ? ' selected' : '' }}>{{ 'run_index.filter_errors_without'|trans }}</option>
                            </select>
                        </label>
                        <label class="run-filter-field">
                            <span class="run-filter-label">{{ 'run_index.filter_from_label'|trans }}</span>
                            <input type="date" name="from" value="{{ executionFilters.dateFrom ? executionFilters.dateFrom|date('Y-m-d') : '' }}" class="search-input">
                        </label>
                        <label class="run-filter-field">
                            <span class="run-filter-label">{{ 'run_index.filter_to_label'|trans }}</span>
                            <input type="date" name="to" value="{{ executionFilters.dateTo ? executionFilters.dateTo|date('Y-m-d') : '' }}" class="search-input">
                        </label>
                    </div>
                    <div class="run-filter-actions">
                        <button type="submit" class="secondary-button">
                            <span class="button-icon" aria-hidden="true">{{ icons.icon('search') }}</span>
                            <span class="button-label">{{ 'run_index.apply_filters'|trans }}</span>
                        </button>
                        {% if executionFilters.hasActiveFilters %}
                            <a href="{{ path('fluxx_run_index') }}" class="secondary-button">
                                <span class="button-icon" aria-hidden="true">{{ icons.icon('rotate-ccw') }}</span>
                                <span class="button-label">{{ 'run_index.reset_filters'|trans }}</span>
                            </a>
                        {% endif %}
                    </div>
                </form>

                <div class="polling-controls"
                    data-run-catalog
                    data-run-catalog-poll-url="{{ path('fluxx_run_index_poll', app.request.query.all) }}"
                    data-run-catalog-poll-interval="1000"
                    data-run-catalog-poll-pause-label="{{ 'run_index.pause_polling'|trans }}"
                    data-run-catalog-poll-resume-label="{{ 'run_index.resume_polling'|trans }}"
                    data-run-catalog-poll-loading-label="{{ 'run_index.polling'|trans }}"
                    data-run-catalog-poll-state-live-label="{{ 'run_index.state_live'|trans }}"
                    data-run-catalog-poll-state-error-label="{{ 'run_index.state_error'|trans }}"
                    data-run-catalog-poll-state-offline-label="{{ 'run_index.state_offline'|trans }}"
                    data-run-catalog-poll-refresh-failed-label="{{ 'run_index.refresh_failed'|trans }}"
                >
                    <span class="status-badge status-badge-pending" data-run-catalog-state>{{ 'run_index.loading'|trans }}</span>
                    <button
                        type="button"
                        class="secondary-button"
                        data-run-catalog-poll-toggle
                        aria-pressed="true"
                    >
                        <span class="button-icon button-icon-toggle" aria-hidden="true">
                            <span class="icon-when-active">{{ icons.icon('pause') }}</span>
                            <span class="icon-when-inactive">{{ icons.icon('play') }}</span>
                        </span>
                        <span class="button-label" data-run-catalog-button-label>{{ 'run_index.pause_polling'|trans }}</span>
                    </button>
                    <span class="polling-indicator" data-run-catalog-poll-loader hidden>
                        <span class="polling-spinner" aria-hidden="true"></span>
                        <span>{{ 'run_index.polling'|trans }}</span>
                    </span>
                    <span class="runtime-refresh" data-run-catalog-refresh>{{ 'run_index.waiting'|trans }}</span>
                </div>

                <div data-run-catalog-content>
                    {% include '@Fluxx/runs/_run_catalog_content.html.twig' %}
                </div>
            </section>
        </div>
    </main>
</body>
</html>
