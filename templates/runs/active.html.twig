{% extends '@Fluxx/base.html.twig' %}
{% trans_default_domain 'fluxx' %}
{% import '@Fluxx/_icons.html.twig' as icons %}

{% block title %}{{ 'runs_active.title'|trans }}{% endblock %}

{% block scripts %}
    <script defer src="{{ path('fluxx_script_asset', {'script': 'clickable-rows', v: fluxx_asset_version}) }}"></script>
    <script defer src="{{ path('fluxx_script_asset', {'script': 'run-active', v: fluxx_asset_version}) }}"></script>
{% endblock %}

{% block body %}
    <div class="page-stack">
        <header class="header">
            <div>
                <h1 class="title">{{ 'runs_active.heading'|trans }}</h1>
            </div>
            <div class="header-tools polling-controls polling-controls-inline"
                data-run-active
                data-run-active-poll-url="{{ path('fluxx_run_active_poll') }}"
                data-run-active-poll-interval="1000"
                data-run-active-poll-pause-label="{{ 'runs_active.pause_polling'|trans }}"
                data-run-active-poll-resume-label="{{ 'runs_active.resume_polling'|trans }}"
                data-run-active-poll-loading-label="{{ 'runs_active.polling'|trans }}"
                data-run-active-poll-state-live-label="{{ 'runs_active.state_live'|trans }}"
                data-run-active-poll-state-error-label="{{ 'runs_active.state_error'|trans }}"
                data-run-active-poll-state-offline-label="{{ 'runs_active.state_offline'|trans }}"
                data-run-active-poll-refresh-failed-label="{{ 'runs_active.refresh_failed'|trans }}"
            >
                <span class="status-badge status-badge-pending" data-run-active-state>{{ 'runs_active.loading'|trans }}</span>
                <button
                    type="button"
                    class="secondary-button"
                    data-run-active-poll-toggle
                    aria-pressed="true"
                >
                    <span class="button-icon button-icon-toggle" aria-hidden="true">
                        <span class="icon-when-active">{{ icons.icon('pause') }}</span>
                        <span class="icon-when-inactive">{{ icons.icon('play') }}</span>
                    </span>
                    <span class="button-label" data-run-active-button-label>{{ 'runs_active.pause_polling'|trans }}</span>
                </button>
                <span class="polling-indicator" data-run-active-poll-loader hidden>
                    <span class="polling-spinner" aria-hidden="true"></span>
                    <span>{{ 'runs_active.polling'|trans }}</span>
                </span>
                <span class="runtime-refresh" data-run-active-refresh>{{ 'runs_active.waiting'|trans }}</span>
            </div>
        </header>

        <section class="section-card">
            <div data-run-active-content>
                {% include '@Fluxx/runs/_active_runs_content.html.twig' %}
            </div>
        </section>
    </div>
{% endblock %}
